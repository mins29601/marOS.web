{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1280px"
		},
		"color": {
			"palette": [
				{ "slug": "primary", "name": "Bronce", "color": "#8A6F4E" },
				{ "slug": "primary-accent", "name": "Arena", "color": "#EFE6DA" },
				{ "slug": "primary-alt", "name": "Piedra", "color": "#D9CBB8" },
				{ "slug": "primary-alt-accent", "name": "Olivo", "color": "#4F5641" },
				{ "slug": "main", "name": "Tinta", "color": "#1F1D1A" },
				{ "slug": "main-accent", "name": "Tinta suave", "color": "#D8D2C8" },
				{ "slug": "base", "name": "Blanco cálido", "color": "#FBF9F6" },
				{ "slug": "secondary", "name": "Gris cálido", "color": "#6B655C" },
				{ "slug": "tertiary", "name": "Lino", "color": "#F3EFE9" },
				{ "slug": "border-light", "name": "Borde claro", "color": "#E6E0D7" },
				{ "slug": "border-dark", "name": "Borde oscuro", "color": "#4A453E" }
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"slug": "primary",
					"name": "DM Sans",
					"fontFamily": "\"DM Sans\", system-ui, sans-serif",
					"fontFace": [
						{ "fontFamily": "DM Sans", "fontStyle": "normal", "fontWeight": "100 1000", "fontDisplay": "swap", "src": [ "file:./assets/fonts/dm-sans/DMSans-VariableFont_opsz,wght.woff2" ] }
					]
				},
				{
					"slug": "heading",
					"name": "Fraunces",
					"fontFamily": "Fraunces, Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": [ "file:./assets/fonts/fraunces/Fraunces-VariableFont_SOFT,WONK,opsz,wght.woff2" ] }
					]
				},
				{ "slug": "expanded", "name": "DM Sans (expanded)", "fontFamily": "\"DM Sans\", system-ui, sans-serif" },
				{ "slug": "condensed", "name": "DM Sans (condensed)", "fontFamily": "\"DM Sans\", system-ui, sans-serif" },
				{ "slug": "narrow", "name": "DM Sans (narrow)", "fontFamily": "\"DM Sans\", system-ui, sans-serif" },
				{ "slug": "monospace", "name": "Monospace", "fontFamily": "monospace" }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--main)" },
		"typography": { "fontFamily": "var(--wp--preset--font-family--primary)", "lineHeight": "1.6" },
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "300", "letterSpacing": "-0.01em", "lineHeight": "1.15" }
			},
			"link": {
				"color": { "text": "var(--wp--preset--color--main)" },
				":hover": { "color": { "text": "var(--wp--preset--color--primary)" } }
			},
			"button": {
				"color": { "background": "var(--wp--preset--color--main)", "text": "var(--wp--preset--color--base)" },
				"border": { "radius": "2px" },
				"typography": { "fontSize": "0.85rem", "fontWeight": "500", "letterSpacing": "0.08em", "textTransform": "uppercase" },
				"spacing": { "padding": { "top": "0.9em", "bottom": "0.9em", "left": "1.6em", "right": "1.6em" } },
				":hover": { "color": { "background": "var(--wp--preset--color--primary)", "text": "var(--wp--preset--color--base)" } }
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontSize": "1.2rem", "fontWeight": "400", "letterSpacing": "0.18em", "textTransform": "uppercase" }
			},
			"core/post-title": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "300" }
			}
		}
	}
}
