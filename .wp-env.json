{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.3",
	"port": 8888,
	"testsPort": 8889,
	"themes": [
		"https://downloads.wordpress.org/theme/ollie.zip"
	],
	"plugins": [
		"https://downloads.wordpress.org/plugin/wordpress-seo.zip"
	],
	"mappings": {
		"wp-content/mu-plugins": "./wp-content/mu-plugins",
		"wp-content/maros-mock": "./mock/maros-api"
	},
	"config": {
		"WP_ENVIRONMENT_TYPE": "local",
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"SCRIPT_DEBUG": true,
		"DISABLE_WP_CRON": false,
		"MAROS_ENV": "mock",
		"MAROS_API_BASE": "http://localhost/wp-json/maros-mock",
		"MAROS_API_KEY": "mock-local-no-secreta",
		"MAROS_WEBHOOK_SECRET": "mock-local-no-secreta"
	},
	"lifecycleScripts": {
		"afterStart": "npx wp-env run cli wp rewrite structure '/%postname%/' --hard && npx wp-env run cli wp theme activate ollie"
	}
}
